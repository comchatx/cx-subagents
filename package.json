{
  "name": "@comchatx/cx-subagents",
  "version": "0.2.0",
  "description": "Puts what cx does in the background on the board.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-subagents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-subagents.git"
  },
  "bugs": "https://github.com/comchatx/cx-subagents/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/board-cards.ts"
    ]
  },
  "files": [
    "extensions"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comchatx": {
    "about": "把 cx 在后台做的事放到看板上。",
    "description": "cx 在后台做一件事时，看板的待处理里会出现一张卡片，写着 cx 交代的内容。做完后，卡片换成结果；30 分钟还没做完，卡片显示「超时」和已做到的部分。\n\n## 费用\n\n后台的工作和 cx 用同一个模型，由同一份余额付费。后台有工作时，cx 的电脑保持开机，开机时长也要付费。",
    "mark": {
      "line": "rocket"
    },
    "section": "extensions",
    "builds": [
      "pi-subagents",
      "@comchatx/cx-board"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "pi-subagents": "0.85.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
