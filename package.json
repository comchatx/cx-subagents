{
  "name": "@comchatx/cx-subagents",
  "version": "0.3.1",
  "description": "Lets cx hand off long jobs, with results on the board.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-subagents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-subagents.git"
  },
  "bugs": "https://github.com/comchatx/cx-subagents/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/board-cards.ts",
      "./extensions/hand-out.ts"
    ]
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  },
  "files": [
    "agents",
    "extensions",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comchatx": {
    "about": "让 cx 把费时的事交给帮手去做，结果放上看板。",
    "mark": {
      "line": "rocket"
    },
    "section": "extensions",
    "builds": [
      {
        "on": "pi-subagents",
        "tested": "0.87.0"
      },
      "@comchatx/cx-board"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "pi-subagents": "0.87.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
