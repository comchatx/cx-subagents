{
  "name": "@comchatx/cx-subagents",
  "version": "0.7.0",
  "description": "Lets cx hand off long jobs, with results on the board.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-subagents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-subagents.git"
  },
  "bugs": "https://github.com/comchatx/cx-subagents/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/board-cards.ts",
      "./extensions/hand-out.ts"
    ]
  },
  "pi-subagents": {
    "agents": [
      "./agents"
    ]
  },
  "files": [
    "agents",
    "extensions",
    "page",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comchatx": {
    "name": "cx Helpers",
    "nameZh": "cx 帮手",
    "about": "让 cx 把费时的事交给帮手去做，结果放上看板。",
    "mark": {
      "line": "rocket"
    },
    "section": "extensions",
    "env": {
      "PI_SUBAGENTS_TEMP_ROOT": "{data}/pi-subagents"
    },
    "board": {
      "tab": "帮手",
      "page": "page/helpers.html",
      "name": {
        "zh": "帮手",
        "en": "Helpers"
      }
    },
    "builds": [
      {
        "on": "pi-subagents",
        "tested": "0.89.1",
        "why": {
          "en": "Lets helpers work in the background.",
          "zh": "用于让帮手在后台做事。"
        }
      },
      {
        "on": "@comchatx/cx-board",
        "why": {
          "en": "Puts helpers' cards on the board.",
          "zh": "用于在看板上放帮手的卡片。"
        }
      }
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "happy-dom": "21.0.4",
    "pi-subagents": "0.89.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "@juicesharp/rpiv-todo": "2.15.0"
  }
}
