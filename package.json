{
  "name": "@comchatx/cx-subagents",
  "version": "0.2.1",
  "description": "Puts what cx does in the background on the board.",
  "license": "MIT",
  "author": "ComChatX",
  "homepage": "https://github.com/comchatx/cx-subagents#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/comchatx/cx-subagents.git"
  },
  "bugs": "https://github.com/comchatx/cx-subagents/issues",
  "keywords": [
    "pi-package"
  ],
  "type": "module",
  "pi": {
    "extensions": [
      "./extensions/board-cards.ts"
    ]
  },
  "files": [
    "extensions",
    "README.zh-CN.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "comchatx": {
    "about": "把 cx 在后台做的事放到看板上。",
    "mark": {
      "line": "rocket"
    },
    "section": "extensions",
    "builds": [
      "pi-subagents",
      "@comchatx/cx-board"
    ]
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "pi-subagents": "0.85.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
